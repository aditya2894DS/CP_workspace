{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CP: debug current file",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\debug.exe",
      "args": ["<", "${fileDirname}\\input.txt"],
      "cwd": "${fileDirname}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/msys64/ucrt64/bin/gdb.exe",
      "preLaunchTask": "CP: build debug",
      "setupCommands": [
        { "description": "Enable pretty-printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ]
    }
  ]
}
